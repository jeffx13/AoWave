{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "bench",
      "displayName": "Start-up bench (Release, no shader seed)",
      "inherits": "release",
      "cacheVariables": { "AOWAVE_SHADER_SEED": "OFF" }
    },
    {
      "name": "manual",
      "displayName": "Debug tree for the manual runs (screens, measure, live)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "noaji",
      "displayName": "Debug without the AnimeJaNai upscaler",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "AOWAVE_ANIMEJANAI": "OFF" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/Desktop_Qt_6_12_0_MSVC2022_64bit_Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "bench", "configurePreset": "bench" },
    { "name": "manual", "configurePreset": "manual" },
    { "name": "noaji", "configurePreset": "noaji" },
    { "name": "debug", "configurePreset": "debug" }
  ]
}
